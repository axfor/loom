{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Loom",
  "scopeName": "source.loom",
  "fileTypes": [
    "lm"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#import"
    },
    {
      "include": "#unknown-statement"
    },
    {
      "include": "#caught"
    },
    {
      "include": "#separator"
    },
    {
      "include": "#resource"
    },
    {
      "include": "#condition"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#predicate"
    },
    {
      "include": "#axis"
    },
    {
      "include": "#group"
    },
    {
      "include": "#string"
    },
    {
      "include": "#fence"
    },
    {
      "include": "#literal"
    },
    {
      "include": "#named-argument"
    },
    {
      "include": "#number"
    },
    {
      "include": "#step"
    },
    {
      "include": "#format"
    },
    {
      "include": "#object"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "match": "(//).*$",
      "name": "comment.line.double-slash.loom",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.loom"
        }
      }
    },
    "import": {
      "comment": "import \"/path\" · import name \"/path\" · import base \"/path\" (base points at another upstream file)",
      "match": "^\\s*(import)\\b(?:\\s+(?:(base)\\b|([\\p{L}_][\\p{L}\\p{N}_]*)))?",
      "captures": {
        "1": {
          "name": "keyword.control.import.loom"
        },
        "2": {
          "name": "variable.language.loom"
        },
        "3": {
          "name": "variable.other.object.loom"
        }
      }
    },
    "unknown-statement": {
      "comment": "A statement starts with an object (`base.`, `self.`, an imported name), a word of the language (`import`, `if`, `return`, `fn`, `Self`), or a name catching a result. A bare word at the start of a line is a typo; build would reject it too. Settings live in loom.om, which is its own language, so `take` or `output` here is a mistake like any other.",
      "match": "^\\s*(?!(?:import|base|self|if|else|return|fn|Self)\\b)([\\p{L}_][\\p{L}\\p{N}_]*)\\b(?!\\s*[.:(=])",
      "captures": {
        "1": {
          "name": "invalid.illegal.unknown-statement.loom"
        }
      }
    },
    "string": {
      "name": "string.quoted.double.loom",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.loom"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.loom"
        }
      },
      "patterns": [
        {
          "match": "\\\\[\"\\\\]",
          "name": "constant.character.escape.loom"
        },
        {
          "include": "#placeholder"
        }
      ]
    },
    "literal": {
      "comment": "`...` is content written in place. It may span lines and has no escapes.",
      "name": "string.quoted.other.raw.loom",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.loom"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.loom"
        }
      },
      "patterns": [
        {
          "include": "#placeholder"
        }
      ]
    },
    "placeholder": {
      "patterns": [
        {
          "comment": "{{@@name}} is the literal text {{@name}}",
          "match": "\\{\\{@@[A-Za-z_][A-Za-z0-9_]*\\}\\}",
          "name": "constant.character.escape.placeholder.loom"
        },
        {
          "match": "(\\{\\{@)([A-Za-z_][A-Za-z0-9_]*)(\\}\\})",
          "captures": {
            "1": {
              "name": "punctuation.definition.placeholder.begin.loom"
            },
            "2": {
              "name": "variable.other.placeholder.loom"
            },
            "3": {
              "name": "punctuation.definition.placeholder.end.loom"
            }
          }
        }
      ]
    },
    "named-argument": {
      "patterns": [
        {
          "match": "\\b(reason|after|before|match|level)\\s*(:)",
          "captures": {
            "1": {
              "name": "variable.parameter.loom"
            },
            "2": {
              "name": "punctuation.separator.key-value.loom"
            }
          }
        },
        {
          "comment": "reason: on an edit, after: / before: on a move, match: / level: in a predicate — anything else is a typo",
          "match": "([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(:)",
          "captures": {
            "1": {
              "name": "invalid.illegal.unknown-argument.loom"
            },
            "2": {
              "name": "punctuation.separator.key-value.loom"
            }
          }
        }
      ]
    },
    "step": {
      "patterns": [
        {
          "comment": "err.format(...): the build's own error, written by return",
          "match": "(?<=\\berr)(\\.)\\s*(format)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.loom"
            },
            "2": {
              "name": "entity.name.function.method.loom"
            }
          }
        },
        {
          "comment": "methods: they change base",
          "match": "(\\.)\\s*(after|before|start|append|replace|drop|set|merge|wrap|swap|unwrap|split|join|move|promote|demote|project|end)\\s*(?=[({])",
          "captures": {
            "1": {
              "name": "punctuation.accessor.loom"
            },
            "2": {
              "name": "entity.name.function.method.loom"
            }
          }
        },
        {
          "comment": "kind(\"name\"): a node that is not the file type's default kind",
          "match": "(\\.)\\s*(section|line|function|marker|key)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.loom"
            },
            "2": {
              "name": "support.type.kind.loom"
            }
          }
        },
        {
          "match": "(\\.)\\s*(as)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.loom"
            },
            "2": {
              "name": "keyword.operator.as.loom"
            }
          }
        },
        {
          "comment": "anything else called like a method is not one: a typo like .aftr(",
          "match": "(\\.)\\s*([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(?=[({])",
          "captures": {
            "1": {
              "name": "punctuation.accessor.loom"
            },
            "2": {
              "name": "invalid.illegal.unknown-method.loom"
            }
          }
        },
        {
          "match": "(\\.)\\s*(frontmatter|body)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.loom"
            },
            "2": {
              "name": "support.variable.property.loom"
            }
          }
        },
        {
          "comment": "a node written as a name: base.Install, base.Usage_Tips (_ matches a space)",
          "match": "(\\.)\\s*([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.loom"
            },
            "2": {
              "name": "variable.other.property.loom"
            }
          }
        },
        {
          "comment": "a node written as a string: base.\"How it compares\"",
          "match": "\\.(?=\\s*\")",
          "name": "punctuation.accessor.loom"
        }
      ]
    },
    "format": {
      "match": "\\b(markdown|toml|yaml|json|shell|text)\\b",
      "name": "entity.name.type.format.loom"
    },
    "object": {
      "patterns": [
        {
          "match": "\\b(base|self)\\b",
          "name": "variable.language.loom"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\.)",
          "name": "variable.other.object.loom"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "\\{",
          "name": "punctuation.section.block.begin.loom"
        },
        {
          "match": "\\}",
          "name": "punctuation.section.block.end.loom"
        },
        {
          "match": "\\(",
          "name": "punctuation.section.parens.begin.loom"
        },
        {
          "match": "\\)",
          "name": "punctuation.section.parens.end.loom"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.loom"
        }
      ]
    },
    "fence": {
      "patterns": [
        {
          "comment": "A fence tagged markdown: its content is that language, highlighted as such.",
          "begin": "(`{3,})[ \\t]*(markdown)[ \\t]*$",
          "end": "^[ \\t]*(\\1)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.loom"
            },
            "2": {
              "name": "entity.name.type.format.loom"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.loom"
            }
          },
          "name": "meta.embedded.block.markdown.loom",
          "patterns": [
            {
              "include": "text.html.markdown"
            },
            {
              "include": "#placeholder"
            }
          ]
        },
        {
          "comment": "A fence tagged sh|shell|bash: its content is that language, highlighted as such.",
          "begin": "(`{3,})[ \\t]*(sh|shell|bash)[ \\t]*$",
          "end": "^[ \\t]*(\\1)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.loom"
            },
            "2": {
              "name": "entity.name.type.format.loom"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.loom"
            }
          },
          "name": "meta.embedded.block.sh|shell|bash.loom",
          "patterns": [
            {
              "include": "source.shell"
            },
            {
              "include": "#placeholder"
            }
          ]
        },
        {
          "comment": "A fence tagged json: its content is that language, highlighted as such.",
          "begin": "(`{3,})[ \\t]*(json)[ \\t]*$",
          "end": "^[ \\t]*(\\1)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.loom"
            },
            "2": {
              "name": "entity.name.type.format.loom"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.loom"
            }
          },
          "name": "meta.embedded.block.json.loom",
          "patterns": [
            {
              "include": "source.json"
            },
            {
              "include": "#placeholder"
            }
          ]
        },
        {
          "comment": "A fence tagged yaml|yml: its content is that language, highlighted as such.",
          "begin": "(`{3,})[ \\t]*(yaml|yml)[ \\t]*$",
          "end": "^[ \\t]*(\\1)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.loom"
            },
            "2": {
              "name": "entity.name.type.format.loom"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.loom"
            }
          },
          "name": "meta.embedded.block.yaml|yml.loom",
          "patterns": [
            {
              "include": "source.yaml"
            },
            {
              "include": "#placeholder"
            }
          ]
        },
        {
          "comment": "A fence tagged toml: its content is that language, highlighted as such.",
          "begin": "(`{3,})[ \\t]*(toml)[ \\t]*$",
          "end": "^[ \\t]*(\\1)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.loom"
            },
            "2": {
              "name": "entity.name.type.format.loom"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.loom"
            }
          },
          "name": "meta.embedded.block.toml.loom",
          "patterns": [
            {
              "include": "source.toml"
            },
            {
              "include": "#placeholder"
            }
          ]
        },
        {
          "comment": "A fence tagged js|javascript: its content is that language, highlighted as such.",
          "begin": "(`{3,})[ \\t]*(js|javascript)[ \\t]*$",
          "end": "^[ \\t]*(\\1)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.loom"
            },
            "2": {
              "name": "entity.name.type.format.loom"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.loom"
            }
          },
          "name": "meta.embedded.block.js|javascript.loom",
          "patterns": [
            {
              "include": "source.js"
            },
            {
              "include": "#placeholder"
            }
          ]
        },
        {
          "comment": "A fence with no tag, or one for a language nothing here embeds.",
          "begin": "(`{3,})[ \\t]*(\\w*)[ \\t]*$",
          "end": "^[ \\t]*(\\1)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.loom"
            },
            "2": {
              "name": "entity.name.type.format.loom"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.loom"
            }
          },
          "name": "string.quoted.other.raw.loom",
          "patterns": [
            {
              "include": "#placeholder"
            }
          ]
        }
      ]
    },
    "number": {
      "comment": "a predicate's level: takes one",
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.loom"
    },
    "keyword": {
      "comment": "the words that are the language rather than a name",
      "match": "(?<![\\w.])(if|else|return|fn|err|Self)(?![\\w])",
      "name": "keyword.control.loom"
    },
    "axis": {
      "comment": "a step to a node the document relates to this one",
      "match": "(\\.)\\s*(children|next|prev|parent|first|last|any|count|has|start|end|append|after|before)(?![\\w({\\[])",
      "captures": {
        "1": {
          "name": "punctuation.accessor.loom"
        },
        "2": {
          "name": "support.function.axis.loom"
        }
      }
    },
    "predicate": {
      "comment": "inside brackets: what a predicate may ask, and how",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.loom"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.loom"
        }
      },
      "patterns": [
        {
          "match": "\\b(level|name|value|empty|calls|has)\\b",
          "name": "support.function.predicate.loom"
        },
        {
          "match": "(==|!=|<=|>=|<|>|~|&&|\\|\\||!)",
          "name": "keyword.operator.loom"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        }
      ]
    },
    "separator": {
      "comment": "the line of dashes: everything after it is resource sections",
      "match": "^\\s*---+\\s*$",
      "name": "punctuation.definition.section.loom"
    },
    "group": {
      "comment": "a group of nodes: every one of a kind, or those a predicate in brackets picks",
      "match": "(\\.)\\s*(sections|lines|functions|markers|keys|values)(?![\\w])",
      "captures": {
        "1": {
          "name": "punctuation.accessor.loom"
        },
        "2": {
          "name": "support.type.group.loom"
        }
      }
    },
    "resource": {
      "comment": "Self: / Self as name: — a resource section after the dashes",
      "match": "^\\s*(Self)\\b(?:\\s+(as)\\s+([\\p{L}_][\\p{L}\\p{N}_]*))?\\s*(:)",
      "captures": {
        "1": {
          "name": "keyword.control.loom"
        },
        "2": {
          "name": "keyword.operator.as.loom"
        },
        "3": {
          "name": "entity.name.section.loom"
        },
        "4": {
          "name": "punctuation.separator.key-value.loom"
        }
      }
    },
    "caught": {
      "comment": "ok = ...: a result caught for an if to ask about, and the ! that asks whether it failed",
      "patterns": [
        {
          "match": "^\\s*([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(=)(?!=)",
          "captures": {
            "1": {
              "name": "variable.other.readwrite.loom"
            },
            "2": {
              "name": "keyword.operator.assignment.loom"
            }
          }
        },
        {
          "match": "(?<=\\bif)\\s*(!)",
          "captures": {
            "1": {
              "name": "keyword.operator.logical.loom"
            }
          }
        }
      ]
    },
    "condition": {
      "comment": "an if's question runs to the { that opens its block, which is not a method's block — so a name before it is a node, not a method misspelled",
      "begin": "(?<![\\w.])(if)(?![\\w])",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.loom"
        }
      },
      "end": "(?=\\{)|$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#caught"
        },
        {
          "include": "#predicate"
        },
        {
          "include": "#axis"
        },
        {
          "include": "#group"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#object"
        },
        {
          "match": "(\\.)\\s*([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.loom"
            },
            "2": {
              "name": "variable.other.property.loom"
            }
          }
        }
      ]
    }
  }
}
