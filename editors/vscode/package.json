{
  "name": "loom-lang",
  "displayName": "Loom",
  "description": "Loom for VS Code: syntax highlighting for .lm templates and settings, .e variable files and {{@name}} placeholders; the compiler's own errors underlined as you type; completion of nodes, methods, our sections and import paths; a live preview of the product a template builds; a unified diff of the template's product against upstream; go to definition from a template to the upstream or our file and node it names.",
  "version": "1.0.3",
  "publisher": "axfor",
  "icon": "icons/loom.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/axfor/loom"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:loom",
    "onLanguage:loom-env",
    "onCommand:loom.showPreview",
    "onCommand:loom.showReview",
    "onCommand:loom.showPatch",
    "onCommand:loom.showTreePatch"
  ],
  "main": "./extension.js",
  "contributes": {
    "configurationDefaults": {
      "explorer.fileNesting.enabled": true,
      "explorer.fileNesting.expand": false,
      "explorer.fileNesting.patterns": {
        "*": "${capture}.lm, ${basename}.lm"
      }
    },
    "languages": [
      {
        "id": "loom",
        "aliases": [
          "Loom",
          "lm"
        ],
        "extensions": [
          ".lm"
        ],
        "icon": {
          "light": "./icons/loom.svg",
          "dark": "./icons/loom.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "loom-env",
        "aliases": [
          "Loom Variables"
        ],
        "extensions": [
          ".e"
        ],
        "icon": {
          "light": "./icons/loom.svg",
          "dark": "./icons/loom.svg"
        },
        "configuration": "./env-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "loom",
        "scopeName": "source.loom",
        "path": "./syntaxes/loom.tmLanguage.json"
      },
      {
        "language": "loom-env",
        "scopeName": "source.loom-env",
        "path": "./syntaxes/loom-env.tmLanguage.json"
      },
      {
        "scopeName": "loom.placeholder.injection",
        "path": "./syntaxes/loom-placeholder.injection.json",
        "injectTo": [
          "text.html.markdown",
          "source.shell",
          "source.json",
          "source.json.comments",
          "source.toml",
          "source.yaml",
          "text.plain",
          "source.js",
          "source.ts",
          "source.python",
          "source.go",
          "text.html.basic",
          "source.css",
          "source.ini",
          "source.makefile",
          "source.dockerfile"
        ]
      }
    ],
    "commands": [
      {
        "command": "loom.showPreview",
        "title": "Open Preview to the Side",
        "category": "Loom",
        "icon": "$(open-preview)"
      },
      {
        "command": "loom.showReview",
        "title": "Review Against Upstream",
        "category": "Loom",
        "icon": "$(diff)"
      },
      {
        "command": "loom.showPatch",
        "title": "Show Patch Against Upstream",
        "category": "Loom",
        "icon": "$(git-compare)"
      },
      {
        "command": "loom.showTreePatch",
        "title": "Show Patch Against Upstream: Whole Tree",
        "category": "Loom"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "loom.showPreview",
          "when": "resourceExtname == .lm && resourceFilename != loom.lm",
          "group": "navigation"
        },
        {
          "command": "loom.showReview",
          "when": "resourceExtname == .lm && resourceFilename != loom.lm",
          "group": "navigation"
        },
        {
          "command": "loom.showPatch",
          "when": "resourceExtname == .lm && resourceFilename != loom.lm",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "loom.showPreview",
          "when": "resourceExtname == .lm && resourceFilename != loom.lm"
        },
        {
          "command": "loom.showReview",
          "when": "resourceExtname == .lm && resourceFilename != loom.lm"
        },
        {
          "command": "loom.showPatch",
          "when": "resourceExtname == .lm && resourceFilename != loom.lm"
        },
        {
          "command": "loom.showTreePatch",
          "when": "resourceExtname == .lm && resourceFilename != loom.lm"
        }
      ]
    },
    "keybindings": [
      {
        "command": "loom.showPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && resourceExtname == .lm && resourceFilename != loom.lm"
      }
    ],
    "configuration": {
      "title": "Loom",
      "properties": {
        "loom.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `lm` command the preview runs. Empty: `lm` on `PATH`, then Go's install directory (`$GOBIN`, or `$GOPATH/bin`, or `~/go/bin`)."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/tokenize.js && node test/definition.js && node test/hover.js && node test/signature.js && node test/completion.js && node test/wordpattern.js && node test/nesting.js && node test/preview.js && node test/diagnostics.js && node test/patch.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
